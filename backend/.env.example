# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration
# Choose one: gmail, sendgrid, ethereal, or smtp
EMAIL_SERVICE=gmail

# Gmail Configuration (if using gmail service)
EMAIL_USER=your.email@gmail.com
EMAIL_PASSWORD=your_app_password_here  # Use Gmail App Password, not your regular password

# SendGrid Configuration (if using sendgrid service)
# SENDGRID_API_KEY=your_sendgrid_api_key

# Custom SMTP Configuration (if using smtp service)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_password

# Ethereal Configuration (if using ethereal service for testing)
# ETHEREAL_HOST=smtp.ethereal.email
# ETHEREAL_PORT=587
# ETHEREAL_USER=your_ethereal_user@ethereal.email
# ETHEREAL_PASS=your_ethereal_password

# Email Settings
PORTFOLIO_EMAIL=your.email@gmail.com  # Where to send contact form submissions
EMAIL_FROM_NAME=Sudhakar
EMAIL_FROM_ADDRESS=your.email@gmail.com
SEND_CONFIRMATION_EMAIL=true  # Send confirmation email to user

# Optional: Database Configuration (for future features)
# DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/portfolio
